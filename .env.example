# ============================================
# CANNEO - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# ============================================
# AMBIENTE
# ============================================
NODE_ENV=development
APP_ENV=development

# ============================================
# DATABASE - PostgreSQL
# ============================================
DATABASE_URL="postgresql://canneo:canneo_password@localhost:5432/canneo_db?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# AUTENTICAÇÃO - NextAuth / JWT
# ============================================
NEXTAUTH_SECRET="sua-chave-secreta-super-segura-aqui-min-32-chars"
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET="sua-chave-jwt-secreta-aqui-min-32-chars"
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# API URLs
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_HOOKS_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ============================================
# PORTAIS - URLs Públicas
# ============================================
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_DOCTOR_URL=http://localhost:3002
NEXT_PUBLIC_PATIENT_URL=http://localhost:3000
NEXT_PUBLIC_PHARMACY_URL=http://localhost:3003

# ============================================
# API - NestJS
# ============================================
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ============================================
# WEBHOOKS SERVICE
# ============================================
HOOKS_PORT=4001
HOOKS_HOST=0.0.0.0
HOOKS_SECRET="webhook-secret-key-min-32-chars"

# ============================================
# S3 / MinIO - Armazenamento de Arquivos
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=canneo-documents
S3_PUBLIC_URL=http://localhost:9000

# ============================================
# EMAIL - SMTP / SES
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CANNEO
SMTP_FROM_EMAIL=noreply@canneo.com.br

# ============================================
# SMS - Twilio / Zenvia
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# PUSH NOTIFICATIONS - Firebase
# ============================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================
# PAGAMENTOS - Stripe / PagSeguro
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PAGSEGURO_EMAIL=
PAGSEGURO_TOKEN=
PAGSEGURO_SANDBOX=true

# ============================================
# VIDEO CHAMADA - Daily.co / Twilio Video
# ============================================
DAILY_API_KEY=
DAILY_DOMAIN=

TWILIO_VIDEO_ACCOUNT_SID=
TWILIO_VIDEO_API_KEY=
TWILIO_VIDEO_API_SECRET=

# ============================================
# PRESCRIÇÃO DIGITAL - Memed / Nexodata
# ============================================
MEMED_API_KEY=
MEMED_SECRET_KEY=
MEMED_SANDBOX=true

# ============================================
# ASSINATURA DIGITAL - Certisign / BirdID
# ============================================
CERTISIGN_API_KEY=
CERTISIGN_SECRET=
DIGITAL_SIGNATURE_PROVIDER=certisign

# ============================================
# INTEGRAÇÃO CFM/CRM - Validação de Médicos
# ============================================
CFM_API_URL=
CFM_API_KEY=

# ============================================
# ANVISA - Consulta de Medicamentos
# ============================================
ANVISA_API_URL=
ANVISA_API_KEY=

# ============================================
# SNCR - Sistema Nacional de Controle de Receituário
# ============================================
SNCR_API_URL=
SNCR_API_KEY=
SNCR_API_SECRET=
SNCR_SANDBOX=true

# ============================================
# LOGS E MONITORAMENTO
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=json

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# DataDog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# CACHE
# ============================================
CACHE_TTL=300
CACHE_MAX_ITEMS=1000

# ============================================
# UPLOADS
# ============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ============================================
# CRIPTOGRAFIA
# ============================================
ENCRYPTION_KEY="sua-chave-de-criptografia-32-bytes"
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================
# LGPD / COMPLIANCE
# ============================================
DATA_RETENTION_DAYS=365
AUDIT_LOG_ENABLED=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_VIDEO_CALL=true
FEATURE_PRESCRIPTION=true
FEATURE_DIGITAL_SIGNATURE=true
FEATURE_PAYMENT=true
FEATURE_SMS_NOTIFICATION=true
FEATURE_EMAIL_NOTIFICATION=true
FEATURE_PUSH_NOTIFICATION=true
